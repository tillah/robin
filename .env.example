# Required
DISCORD_TOKEN=your-bot-token-here

# Optional: sync slash commands to one server for instant updates (right-click server > Copy Server ID)
DISCORD_GUILD_ID=

# Channel for the daily report, alerts and tracked-opportunity updates (right-click channel > Copy Channel ID)
DISCORD_REPORT_CHANNEL_ID=

# Ollama (defaults shown)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300
OLLAMA_THINK=false

LOG_LEVEL=INFO

# Local storage and research settings file (defaults shown)
DB_PATH=data/robin.db
RESEARCH_CONFIG=research.toml
